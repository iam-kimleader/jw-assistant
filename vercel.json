{
  "version": 2,
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "core/bible/**"
    }
  },
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/web/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/progress.js",
      "destination": "/web/progress.js"
    },
    {
      "source": "/og-image-jw-assistant.png",
      "destination": "/asset/og-image-jw-assistant.png"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/life-ministry",
      "destination": "/web/index.html"
    },
    {
      "source": "/watchtower",
      "destination": "/web/index.html"
    },
    {
      "source": "/talk",
      "destination": "/web/index.html"
    }
  ]
}
