{
  "version": 2,
  "regions": [
    "icn1"
  ],
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "core/bible/**"
    }
  },
  "rewrites": [
    {
      "source": "/life-ministry",
      "destination": "/index.html"
    },
    {
      "source": "/watchtower",
      "destination": "/index.html"
    },
    {
      "source": "/talk",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ]
}
