{
  "name": "jw-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --no-warnings",
    "unpack": "node --no-warnings scripts/unpack-jwpub.mjs",
    "extract:index": "node --no-warnings scripts/extract-index.mjs",
    "extract:refs": "node --no-warnings scripts/extract-refs.mjs",
    "fetch:bible": "node --no-warnings scripts/fetch-bible.mjs",
    "verify": "node --no-warnings scripts/verify-bible.mjs",
    "verify:refs": "node --no-warnings scripts/verify-refs.mjs",
    "refresh:references": "node --no-warnings scripts/refresh-wol-references.mjs",
    "refresh:teaching-lessons": "node --no-warnings scripts/refresh-teaching-lessons.mjs",
    "집회준비": "node --no-warnings scripts/prepare-meeting.mjs",
    "meeting": "node --no-warnings scripts/prepare-meeting.mjs",
    "성구": "node --no-warnings scripts/lookup.mjs",
    "lookup": "node --no-warnings scripts/lookup.mjs",
    "web": "npm run build:web && node --no-warnings src/web-server.mjs",
    "dev:web": "vite",
    "build:web": "node -e \"const{execSync}=require('node:child_process');const fs=require('node:fs');if(fs.existsSync('web/dist')){execSync(process.platform==='win32'?'rmdir /s /q web\\\\dist':'rm -rf web/dist',{stdio:'inherit'})}\" && vite build",
    "typecheck": "tsc --noEmit",
    "smoke:web": "node -e \"const{execSync}=require('node:child_process');const fs=require('node:fs');if(fs.existsSync('web/dist-smoke')){execSync(process.platform==='win32'?'rmdir /s /q web\\\\dist-smoke':'rm -rf web/dist-smoke',{stdio:'inherit'})}\" && vite build --ssr src/smoke.tsx --outDir dist-smoke && node web/dist-smoke/smoke.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
