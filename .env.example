# 서버 전용 환경 변수 예시. 실제 값은 .env 에 넣는다. 이 파일에는 절대 넣지 않는다.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# 추론 강도. none·minimal·low·medium·high·xhigh·max 중 하나다. 생략하면 코드 기본값 high 를 쓴다.
OPENAI_REASONING_EFFORT=high

# 카카오 로그인. 카카오 디벨로퍼스에서 받는다.
# 앱 설정 → 앱 → REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 → 고급 → Client Secret
KAKAO_CLIENT_SECRET=

# 세션 쿠키 서명 열쇠. 아래 명령으로 만든다. 바꾸면 모두 로그아웃된다.
# 없거나 32자보다 짧으면 서버가 모든 요청을 거부한다.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 카카오에 등록한 주소와 글자 하나까지 같아야 한다.
# 로그인은 이 주소와 같은 호스트에서만 된다. 프리뷰 배포(예: preview-xxx.vercel.app)에서는
# 카카오가 이 주소로 돌아오므로 로그인이 되지 않는다.
APP_BASE_URL=http://localhost:3000
